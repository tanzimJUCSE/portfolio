---
import Icon from './Icon.astro';
import { site } from '../lib/content';

const links = [
  { href: '/', label: 'Home' },
  { href: '/publications/', label: 'Publications' },
  { href: '/experience/', label: 'Experience' },
  { href: '/awards/', label: 'Awards' },
  { href: '/projects/', label: 'Projects' },
  { href: '/hobbies/', label: 'Beyond research' },
];

const current = `/${Astro.url.pathname.replace(/^\/+|\/+$/g, '')}/`.replace('//', '/');

const isCurrent = (href: string) => href === current || (href === '/' && current === '/');
---

<header class="site-header">
  <div class="container site-header__inner">
    <a class="brand" href="/">
      <span class="brand__mark" aria-hidden="true">{site.initials}</span>
      <span>{site.name}</span>
    </a>

    <nav class="nav" id="primary-nav" aria-label="Primary">
      {
        links.map((link) => (
          <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
            {link.label}
          </a>
        ))
      }
      {
        site.cv && (
          <a href={site.cv} target="_blank" rel="noopener">
            CV
          </a>
        )
      }
    </nav>

    <div class="header-actions">
      <button class="icon-btn theme-toggle" type="button" id="theme-toggle" aria-label="Switch between dark and light theme">
        <Icon name="moon" />
        <Icon name="sun" />
      </button>
      <button
        class="icon-btn nav-toggle"
        type="button"
        id="nav-toggle"
        aria-controls="primary-nav"
        aria-expanded="false"
        aria-label="Open menu"
      >
        <Icon name="menu" />
      </button>
    </div>
  </div>
</header>

<script is:inline>
  (function () {
    var themeToggle = document.getElementById('theme-toggle');
    if (themeToggle) {
      themeToggle.addEventListener('click', function () {
        var next = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
        document.documentElement.dataset.theme = next;
        try {
          localStorage.setItem('theme', next);
        } catch (error) {
          /* private browsing - the choice just will not persist */
        }
      });
    }

    var navToggle = document.getElementById('nav-toggle');
    var nav = document.getElementById('primary-nav');
    if (navToggle && nav) {
      navToggle.addEventListener('click', function () {
        var open = nav.dataset.open === 'true';
        nav.dataset.open = open ? 'false' : 'true';
        navToggle.setAttribute('aria-expanded', open ? 'false' : 'true');
        navToggle.setAttribute('aria-label', open ? 'Open menu' : 'Close menu');
      });

      nav.addEventListener('click', function (event) {
        if (event.target instanceof HTMLAnchorElement) {
          nav.dataset.open = 'false';
          navToggle.setAttribute('aria-expanded', 'false');
        }
      });
    }
  })();
</script>
